/*
 * Paleta inspirada en la aplicación MindsAI del celular.
 */
private val AppBackground = Color(0xFF080711)
private val AppSurface = Color(0xFF181525)
private val AppSurfaceLight = Color(0xFF252038)

private val AppPurple = Color(0xFF9D7BFF)
private val AppLavender = Color(0xFFC4B5FD)
private val AppCyan = Color(0xFF62D9E8)
private val AppGreen = Color(0xFF55D6A9)
private val AppOrange = Color(0xFFFFAE57)
private val AppRed = Color(0xFFFF637B)

private val AppText = Color(0xFFF5F3FF)
private val AppTextSecondary = Color(0xFFAAA6BB)

private enum class HomePage {
    SUMMARY,
    NEXT_TASK,
    ALERTS,
    RECOMMENDATION
}

private enum class DateState {
    OVERDUE,
    TODAY,
    UPCOMING,
    UNKNOWN
}

@Composable
fun MindsAIHomeCarousel(
    tasks: List<Task>,
    notificationCount: Int,
    onNotificationsClick: () -> Unit,
    modifier: Modifier = Modifier
) {
    val pendingTasks = tasks.filter { !it.completado }
    val completedTasks = tasks.count { it.completado }

    val overdueTasks = pendingTasks.filter {
        taskDateState(it.fecha) == DateState.OVERDUE
    }

    val todayTasks = pendingTasks.filter {
        taskDateState(it.fecha) == DateState.TODAY
    }

    val upcomingTasks = pendingTasks.filter {
        taskDateState(it.fecha) == DateState.UPCOMING
    }

    val unknownDateTasks = pendingTasks.filter {
        taskDateState(it.fecha) == DateState.UNKNOWN
    }

    val orderedTasks =
        overdueTasks +
        todayTasks +
        upcomingTasks +
        unknownDateTasks

    val nextTask = orderedTasks.firstOrNull()

    val progress = when {
        tasks.isEmpty() -> 0f
        else -> completedTasks.toFloat() / tasks.size.toFloat()
    }

    val pages = HomePage.entries

    val pagerState = rememberPagerState(
        initialPage = 0,
        pageCount = { pages.size }
    )

    Box(
        modifier = modifier
            .fillMaxSize()
            .background(AppBackground)
    ) {
        /*
         * Fondo decorativo ligero.
         */
        Canvas(
            modifier = Modifier.fillMaxSize()
        ) {
            drawCircle(
                color = AppPurple.copy(alpha = 0.08f),
                radius = size.minDimension * 0.45f,
                center = Offset(
                    x = size.width * 0.12f,
                    y = size.height * 0.12f
                )
            )

            drawCircle(
                color = AppCyan.copy(alpha = 0.05f),
                radius = size.minDimension * 0.42f,
                center = Offset(
                    x = size.width * 0.90f,
                    y = size.height * 0.82f
                )
            )
        }

        Column(
            modifier = Modifier
                .fillMaxSize()
                .padding(
                    top = 7.dp,
                    bottom = 7.dp
                ),
            horizontalAlignment = Alignment.CenterHorizontally
        ) {
            HomeHeader(
                notificationCount = notificationCount,
                onNotificationsClick = onNotificationsClick
            )

            Spacer(modifier = Modifier.height(4.dp))

            HorizontalPager(
                state = pagerState,
                modifier = Modifier
                    .fillMaxWidth()
                    .height(230.dp),
                pageSpacing = 8.dp,
                verticalAlignment = Alignment.CenterVertically
            ) { page ->
                when (pages[page]) {
                    HomePage.SUMMARY -> {
                        SummaryCard(
                            progress = progress,
                            completed = completedTasks,
                            pending = pendingTasks.size
                        )
                    }

                    HomePage.NEXT_TASK -> {
                        NextTaskCard(
                            task = nextTask
                        )
                    }

                    HomePage.ALERTS -> {
                        AlertsCard(
                            overdue = overdueTasks.size,
                            today = todayTasks.size,
                            upcoming = upcomingTasks.size
                        )
                    }

                    HomePage.RECOMMENDATION -> {
                        RecommendationCard(
                            task = nextTask
                        )
                    }
                }
            }

            Spacer(modifier = Modifier.height(4.dp))

            PaginationDots(
                total = pages.size,
                selected = pagerState.currentPage
            )
        }
    }
}

@Composable
private fun HomeHeader(
    notificationCount: Int,
    onNotificationsClick: () -> Unit
) {
    var now by remember {
        mutableStateOf(Date())
    }

    LaunchedEffect(Unit) {
        while (true) {
            now = Date()
            delay(30_000)
        }
    }

    val timeFormatter = remember {
        SimpleDateFormat(
            "HH:mm",
            Locale.getDefault()
        )
    }

    val dateFormatter = remember {
        SimpleDateFormat(
            "EEE, d MMM",
            Locale.getDefault()
        )
    }

    Box(
        modifier = Modifier
            .fillMaxWidth()
            .height(58.dp)
            .padding(horizontal = 25.dp),
        contentAlignment = Alignment.Center
    ) {
        /*
         * La hora está centrada respecto a toda la pantalla.
         * La campana no desplaza el contenido.
         */
        Column(
            modifier = Modifier.align(Alignment.Center),
            horizontalAlignment = Alignment.CenterHorizontally,
            verticalArrangement = Arrangement.Center
        ) {
            Text(
                text = timeFormatter.format(now),
                color = AppText,
                fontSize = 25.sp,
                fontWeight = FontWeight.Bold,
                textAlign = TextAlign.Center,
                maxLines = 1
            )

            Text(
                text = dateFormatter
                    .format(now)
                    .replaceFirstChar {
                        if (it.isLowerCase()) {
                            it.titlecase(Locale.getDefault())
                        } else {
                            it.toString()
                        }
                    },
                color = AppTextSecondary,
                fontSize = 8.sp,
                textAlign = TextAlign.Center,
                maxLines = 1
            )
        }

        NotificationButton(
            notificationCount = notificationCount,
            onClick = onNotificationsClick,
            modifier = Modifier.align(Alignment.CenterEnd)
        )
    }
}

@Composable
private fun NotificationButton(
    notificationCount: Int,
    onClick: () -> Unit,
    modifier: Modifier = Modifier
) {
    Box(
        modifier = modifier
            .size(38.dp)
            .background(
                color = AppSurfaceLight,
                shape = CircleShape
            )
            .clickable(
                interactionSource = remember {
                    MutableInteractionSource()
                },
                indication = null,
                onClick = onClick
            ),
        contentAlignment = Alignment.Center
    ) {
        BellIcon(
            modifier = Modifier.size(19.dp)
        )

        if (notificationCount > 0) {
            Box(
                modifier = Modifier
                    .size(16.dp)
                    .align(Alignment.TopEnd)
                    .background(
                        color = AppRed,
                        shape = CircleShape
                    ),
                contentAlignment = Alignment.Center
            ) {
                Text(
                    text = notificationCount
                        .coerceAtMost(9)
                        .toString(),
                    color = Color.White,
                    fontSize = 8.sp,
                    fontWeight = FontWeight.Bold,
                    textAlign = TextAlign.Center,
                    maxLines = 1
                )
            }
        }
    }
}

@Composable
fun BellIcon(
    modifier: Modifier = Modifier
) {
    Canvas(modifier = modifier) {
        val strokeWidth = 1.7.dp.toPx()

        val bellPath = Path().apply {
            moveTo(
                size.width * 0.50f,
                size.height * 0.14f
            )

            cubicTo(
                size.width * 0.31f,
                size.height * 0.14f,
                size.width * 0.25f,
                size.height * 0.31f,
                size.width * 0.25f,
                size.height * 0.48f
            )

            lineTo(
                size.width * 0.25f,
                size.height * 0.62f
            )

            cubicTo(
                size.width * 0.25f,
                size.height * 0.69f,
                size.width * 0.18f,
                size.height * 0.75f,
                size.width * 0.14f,
                size.height * 0.80f
            )

            lineTo(
                size.width * 0.86f,
                size.height * 0.80f
            )

            cubicTo(
                size.width * 0.82f,
                size.height * 0.75f,
                size.width * 0.75f,
                size.height * 0.69f,
                size.width * 0.75f,
                size.height * 0.62f
            )

            lineTo(
                size.width * 0.75f,
                size.height * 0.48f
            )

            cubicTo(
                size.width * 0.75f,
                size.height * 0.31f,
                size.width * 0.69f,
                size.height * 0.14f,
                size.width * 0.50f,
                size.height * 0.14f
            )

            close()
        }

        drawPath(
            path = bellPath,
            color = AppText,
            style = Stroke(
                width = strokeWidth,
                cap = StrokeCap.Round
            )
        )

        drawCircle(
            color = AppText,
            radius = size.width * 0.065f,
            center = Offset(
                x = size.width * 0.50f,
                y = size.height * 0.90f
            )
        )
    }
}

@Composable
private fun SummaryCard(
    progress: Float,
    completed: Int,
    pending: Int
) {
    HomeCardContainer(
        accentColor = AppPurple
    ) {
        CardTitle(
            text = "RESUMEN DEL DÍA",
            color = AppLavender
        )

        Spacer(modifier = Modifier.height(8.dp))

        ProgressRing(
            progress = progress
        )

        Spacer(modifier = Modifier.height(7.dp))

        Row(
            modifier = Modifier.fillMaxWidth(),
            horizontalArrangement = Arrangement.SpaceEvenly
        ) {
            SmallMetric(
                value = completed.toString(),
                label = "Terminadas",
                color = AppGreen
            )

            SmallMetric(
                value = pending.toString(),
                label = "Pendientes",
                color = AppOrange
            )
        }
    }
}

@Composable
private fun ProgressRing(
    progress: Float
) {
    Box(
        modifier = Modifier.size(105.dp),
        contentAlignment = Alignment.Center
    ) {
        Canvas(
            modifier = Modifier.fillMaxSize()
        ) {
            val strokeWidth = 9.dp.toPx()
            val inset = strokeWidth / 2f

            drawArc(
                color = AppSurfaceLight,
                startAngle = -90f,
                sweepAngle = 360f,
                useCenter = false,
                topLeft = Offset(inset, inset),
                size = Size(
                    width = size.width - strokeWidth,
                    height = size.height - strokeWidth
                ),
                style = Stroke(
                    width = strokeWidth,
                    cap = StrokeCap.Round
                )
            )

            drawArc(
                color = AppPurple,
                startAngle = -90f,
                sweepAngle =
                    360f * progress.coerceIn(0f, 1f),
                useCenter = false,
                topLeft = Offset(inset, inset),
                size = Size(
                    width = size.width - strokeWidth,
                    height = size.height - strokeWidth
                ),
                style = Stroke(
                    width = strokeWidth,
                    cap = StrokeCap.Round
                )
            )
        }

        Column(
            horizontalAlignment =
                Alignment.CenterHorizontally
        ) {
            Text(
                text = "${(progress * 100).toInt()}%",
                color = AppText,
                fontSize = 23.sp,
                fontWeight = FontWeight.Bold
            )

            Text(
                text = "Progreso",
                color = AppTextSecondary,
                fontSize = 8.sp
            )
        }
    }
}

@Composable
private fun NextTaskCard(
    task: Task?
) {
    HomeCardContainer(
        accentColor = AppCyan
    ) {
        CardTitle(
            text = "PRÓXIMA TAREA",
            color = AppCyan
        )

        Spacer(modifier = Modifier.height(13.dp))

        if (task == null) {
            Text(
                text = "Todo listo",
                color = AppText,
                fontSize = 18.sp,
                fontWeight = FontWeight.Bold,
                textAlign = TextAlign.Center
            )

            Spacer(modifier = Modifier.height(5.dp))

            Text(
                text = "No tienes actividades pendientes",
                color = AppTextSecondary,
                fontSize = 9.sp,
                textAlign = TextAlign.Center,
                maxLines = 2
            )
        } else {
            Text(
                text = task.titulo.ifBlank {
                    "Tarea sin título"
                },
                color = AppText,
                fontSize = 16.sp,
                fontWeight = FontWeight.Bold,
                textAlign = TextAlign.Center,
                maxLines = 2
            )

            Spacer(modifier = Modifier.height(7.dp))

            Text(
                text = task.descripcion.ifBlank {
                    "Sin descripción"
                },
                color = AppTextSecondary,
                fontSize = 9.sp,
                textAlign = TextAlign.Center,
                maxLines = 2
            )

            Spacer(modifier = Modifier.height(11.dp))

            Row(
                modifier = Modifier.fillMaxWidth(),
                horizontalArrangement =
                    Arrangement.SpaceEvenly
            ) {
                InformationItem(
                    label = "Fecha",
                    value = shortDate(task.fecha)
                )

                InformationItem(
                    label = "Hora",
                    value = task.hora.ifBlank {
                        "--:--"
                    }
                )
            }

            Spacer(modifier = Modifier.height(8.dp))

            StatusPill(task)
        }
    }
}

