--- a/build.gradle.kts
+++ b/build.gradle.kts
@@ -1 +1,9 @@
 // Top-level build file where you can add configuration options common to all sub-projects/modules.
+plugins {
+    // Se declaran aquí (con apply false) únicamente para fijar la versión
+    // de estos plugins en el classpath raíz. Los módulos "app" y
+    // "proyectdeswear" los aplican con id(...) sin versión, y Gradle
+    // necesita que la versión quede resuelta desde algún lugar antes.
+    alias(libs.plugins.kotlin.android) apply false
+    alias(libs.plugins.google.services) apply false
+}
